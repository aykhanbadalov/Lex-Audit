# Base path of the backend API. In development Vite proxies /api to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Origin of the real backend's paths (they already start with /api/v1). Empty = same origin (the Vite proxy / nginx).
# VITE_API_ORIGIN=
# Default UI language: az | ru | en
VITE_DEFAULT_LOCALE=az
# Serve mock API responses with MSW instead of calling the backend.
VITE_ENABLE_MSW=true

# Show sample sign-in details under the login inputs (public demo company only; they end up in the built files).
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=
