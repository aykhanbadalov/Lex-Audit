# Base path of the backend API. In development Vite proxies /api to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Default UI language: az | ru | en
VITE_DEFAULT_LOCALE=az
# Serve mock API responses with MSW instead of calling the backend.
VITE_ENABLE_MSW=true
